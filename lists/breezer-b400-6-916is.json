  "emergencies": [
    {
      "id": "ENGINE_FAIL_FLIGHT",
      "title": "Triebwerksstörung im Flug",
      "branches": [
        {
          "id": "EF_PROC",
          "title": "Verfahren",
          "steps": [
            "Geschwindigkeit: 100 km/h (bester Gleitflug)",
            "Landeplatz: Suchen (gegen Wind/Hang)",
            "Gurte: Strammziehen",
            "Notmeldung: Absetzen",
            "Brandhahn: ZU (OFF)",
            "Lanes: AUS",
            "Hauptschalter: AUS",
            "Rettungssystem: Bereithalten (Aktivierung ab 100 m möglich)"
          ]
        }
      ]
    },
    {
      "id": "FIRE_CABIN",
      "title": "Brand oder Rauch in der Kabine",
      "branches": [
        {
          "id": "FC_PROC",
          "title": "Sofortmaßnahmen",
          "steps": [
            "Elektrische Systeme: Unverzüglich AUS",
            "Haube: Entriegeln",
            "Notlandung: Schnellstmöglich durchführen"
          ]
        }
      ]
    },
    {
      "id": "TOW_EMERGENCY",
      "title": "Notfall im Schleppbetrieb",
      "branches": [
        {
          "id": "TE_PROC",
          "title": "Unnormale Lage / Seilbruch",
          "steps": [
            "Segelflugzeug >30° außerhalb Achse: Unverzüglich Ausklinken/Kappen",
            "Übersteigen des Schleppers: Unverzüglich Ausklinken/Kappen",
            "Seil kappen: Hebel an linker Bordwand mit Ruck ziehen",
            "Nachdrücken: Fahrt aufholen"
          ]
        }
      ]
    }
  ]
